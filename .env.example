# Optional. Set the verified production HTTPS origin before building for deployment.
# Without SITE_URL the preview has no canonical URL and remains noindex.
SITE_URL=

# Optional server-side delivery for the contact form. Never expose the key in NEXT_PUBLIC_*.
# Without these, the complete form prepares an email for the visitor's email app.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
