# Optional. Set the verified production HTTPS origin before building for deployment.
# Without SITE_URL the preview has no canonical URL and remains noindex.
SITE_URL=

# Optional server-side delivery for the contact and onsite-assessment forms.
# Assessment requests are addressed to ross@ropeaccess.co.za. Never expose the key in NEXT_PUBLIC_*.
# Without these, each form prepares an email for the visitor's email app.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Careers: Supabase holds vacancy content and privileged admin membership only.
# No CV/application data is saved to the website database or filesystem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used solely for the atomic abuse limiter and vacancy validation.
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random characters. Never use a public env variable.
CAREERS_RATE_LIMIT_SECRET=
# Verified Resend sender. Applications with PDF attachment go to reception@ropeaccess.co.za.
CAREERS_FROM_EMAIL=
# Private contracted scanner: HTTPS raw-PDF POST, bearer auth, {"clean":true} only if fully inspected.
# Must reject encrypted/uninspectable PDFs and retain no documents. No public sample-sharing scanners.
CV_SCANNER_URL=
CV_SCANNER_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
